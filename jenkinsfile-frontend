pipeline {
    agent {
        label 'Anu'
    }

    environment {
        my_aws_credential = credentials('AWS-cred')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/Anushree602/medical-erp.git'
            }
        }

        stage('Build - Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Upload Artifacts to S3') {
            steps {
                dir('frontend') {
                    sh '''
                    aws s3 sync dist/ s3://deploybyanushree.space --delete
                    aws s3 ls s3://deploybyanushree.space/ --recursive
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend deployed successfully.'
        }

        failure {
            echo 'Frontend deployment failed.'
        }
    }
}

