pipeline {
    agent {
        label 'Anu'
    }

    tools {
        maven 'mvn'
    }

    environment {
        my_aws_credential = credentials('AWS-cred')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Anushree602/medical-erp.git'
            }
        }

        stage('Build User-service') {
            steps {
                dir('user-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - user service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('user-service') {
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }

        stage('Build Product-Service') {
            steps {
                dir('product-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'product-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - product service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('product-service') {
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }

        stage('Build Order Service') {
            steps {
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - order service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('order-service') {
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                docker build -t user-service:latest ./user-service
                docker build -t product-service:latest ./product-service 
                docker build -t order-service:latest ./order-service
                docker images
                '''
            }
        }

        stage('Push images to ECR') {
    steps {
        sh '''
        aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 419819289041.dkr.ecr.ap-south-1.amazonaws.com

        docker tag order-service:latest 419819289041.dkr.ecr.ap-south-1.amazonaws.com/order-repo:latest
        docker push 419819289041.dkr.ecr.ap-south-1.amazonaws.com/order-repo:latest

        docker tag product-service:latest 419819289041.dkr.ecr.ap-south-1.amazonaws.com/product-repo:latest
        docker push 419819289041.dkr.ecr.ap-south-1.amazonaws.com/product-repo:latest

        docker tag user-service:latest 419819289041.dkr.ecr.ap-south-1.amazonaws.com/user-repo:latest
        docker push 419819289041.dkr.ecr.ap-south-1.amazonaws.com/user-repo:latest
        '''
    }
}

        stage('Deploy to k8s') {
            steps {
                withAWS(credentials: ${my_aws_credential}, region: 'us-east-1')
                sh '''
                aws sts get-caller-identity
                aws s3 ls
                aws eks update-kubeconfig --region ap-south-1 --name eks-1
                kubectl apply -f k8s/configmaps/
                kubectl apply -f k8s/deployments/
                kubectl apply -f k8s/hpa/
                kubectl apply -f k8s/services/
                kubectl apply -f k8s/ingress/ingressclass.yaml
                kubectl apply -f k8s/ingress/ingress.yaml

                kubectl rollout status deployment/user-service -n med-erp
                kubectl rollout status deployment/product-service -n med-erp
                kubectl rollout status deployment/order-service -n med-erp

                kubectl get pods -n med-erp
                kubectl get svc -n med-erp
                kubectl get hpa -n med-erp
                kubectl get ingress -n med-erp
                '''
            }
        }
    }
}

